# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# .env is untracked as of 2026-09-14. It only ever held the Supabase anon key,
# which is public by design, but a tracked .env is the wrong pattern for the
# next value that is not. It remains in history from 12c1992; that is accepted.
.env
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/

# Node
node_modules/

# Android
android/.gradle/

# iOS
ios/Pods/

# Logs
*.log

# Flutter CLI debug dumps (flutter pub deps / flutter doctor output)
deps.txt
deps.txt4
doctor.txt

# Local-only data snapshots. Never committed: they can hold personal data, and
# this repository is public.
/private/

# Flutter golden-test failure output, written on every failing golden run.
# Ignored rather than committed for a specific reason: the dot_*/ring_* diff
# images it produces look like the baselines in test/goldens/compact_feed and
# would be easy to mistake for them. The baselines are the reviewed artifact;
# these are transient debug output and are stale as soon as a test reruns.
test/failures/

# Generated web build output. web/ is tracked only for the hand-written shell
# (index.html, manifest.json, favicon, icons); flutter.js and its source map
# are produced by `flutter build web`.
web/flutter.js.map
